{
  "name": "@persianpart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./router": {
      "types": "./src/routers/index.ts",
      "import": "./src/routers/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@orpc/client": "2.0.0-beta.42",
    "@orpc/contract": "2.0.0-beta.42",
    "@orpc/openapi": "2.0.0-beta.42",
    "@orpc/server": "2.0.0-beta.42",
    "@payloadcms/sdk": "^3.91.0",
    "@persianpart/cms": "workspace:*",
    "@persianpart/contract": "workspace:*",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
