# Image Tags
TAG=latest
CMS_TAG=latest
API_TAG=latest
WEB_TAG=latest
CDN_TAG=2.0.0

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/persianpart_cms
DATABASE_URI=postgresql://postgres:password@postgres:5432/persianpart_cms

# Secrets (min 32 chars)
PAYLOAD_SECRET=replace-with-a-secure-payload-secret-at-least-32-characters
JWT_SECRET=replace-with-a-secure-jwt-secret-key-at-least-32-characters

# Domains & URLs
CMS_DOMAIN=admin.persianpart.shop
WEB_DOMAIN=persianpart.shop
API_DOMAIN=api.persianpart.shop
CMS_URL=https://admin.persianpart.shop
CORS_ORIGINS=https://admin.persianpart.shop,https://persianpart.shop,https://api.persianpart.shop

# SMS / OTP Provider
KAVENEGAR_API_KEY=your-kavenegar-api-key
KAVENEGAR_OTP_TEMPLATE=gcotp
